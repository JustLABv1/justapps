# Optional coordinated release version for backend, frontend and documentation.
# Example: JUSTAPPS_VERSION=1.8.0
# Leave empty to use the moving component tags: backend, frontend and docs.
JUSTAPPS_VERSION=

# Host ports.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=3000
BACKEND_BIND=127.0.0.1
BACKEND_PORT=8080

# Optional public edge proxy.
PUBLIC_HOST=apps.justlab.app
EDGE_HTTP_BIND=0.0.0.0
EDGE_HTTP_PORT=80

# PostgreSQL bootstrap credentials.
POSTGRES_DB=justapps
POSTGRES_USER=justapps
POSTGRES_PASSWORD=change-me

# Secrets.
BACKEND_JWT_SECRET=replace-with-secure-random-string
BACKEND_REPOSITORY_PROVIDER_ENCRYPTION_SECRET=replace-with-secure-random-string
AUTH_SECRET=replace-with-secure-random-string

# Frontend URLs.
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
INTERNAL_API_URL=http://backend:8080/api/v1
DOCS_INTERNAL_URL=http://docs:3000

# Direct documentation host binding.
DOCS_BIND=127.0.0.1
DOCS_PORT=3001

# For the `edge` profile behind Coolify or another TLS terminator, switch these to your public HTTPS hostname.
# AUTH_URL=https://apps.justlab.app
# NEXT_PUBLIC_API_URL=/api/v1

# OIDC providers are configured at runtime in the admin UI:
# Verwaltung -> Integrationen -> Authentifizierung
